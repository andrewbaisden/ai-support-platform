# Local Docker Compose PostgreSQL. Copy to .env for database commands.
# Use separate credentials and managed secret storage in deployed environments.
DATABASE_URL=postgresql://support:support_dev@127.0.0.1:54339/support_platform
DATABASE_URL_TEST=postgresql://support:support_dev@127.0.0.1:54339/support_platform_test
# Optional public base URL for the demo's real ingestion mode.
# Same-origin/local default applies when unset; never put DATABASE_URL here.
# NEXT_PUBLIC_SUPPORT_API_URL=http://127.0.0.1:3000
