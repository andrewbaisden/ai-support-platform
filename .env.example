# Local Docker Compose PostgreSQL. Copy to .env for database commands.
# Use separate credentials and managed secret storage in deployed environments.
DATABASE_URL=postgresql://support:support_dev@127.0.0.1:54339/support_platform
DATABASE_URL_TEST=postgresql://support:support_dev@127.0.0.1:54339/support_platform_test
# Optional public base URL for the demo's real ingestion mode.
# Same-origin/local default applies when unset; never put DATABASE_URL here.
# NEXT_PUBLIC_SUPPORT_API_URL=http://127.0.0.1:3000
# Live Jev triage only. Normal lint/typecheck/test/build must never require these.
# The SDK also honors TYPESAFE_BASE_URL and TYPESAFE_DEFAULT_MODEL overrides.
# TYPESAFE_API_KEY=
# Dashboard auth (Better Auth, server-only). Never expose these to the browser.
# BETTER_AUTH_SECRET is required to start apps/web; generate a long random value
# per environment. The value below is a local-development placeholder only.
BETTER_AUTH_SECRET=local-dev-only-change-me-in-production-0123456789abcdef
BETTER_AUTH_URL=http://127.0.0.1:3000
# Bootstrap owner for local seed (12+ character password, local only).
# SEED_OWNER_EMAIL=owner@local.example
# SEED_OWNER_PASSWORD=change-me-local-dev-01
