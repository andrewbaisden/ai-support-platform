{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/.next-e2e",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report"
    ]
  }
}
