{
  "name": "ai-support-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:web": "pnpm --filter @ai-support-platform/web dev",
    "dev:demo": "pnpm --filter @ai-support-platform/demo dev",
    "build": "pnpm --filter './apps/*' build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.tooling.json && pnpm --filter './apps/*' typecheck && pnpm --filter @ai-support-platform/db typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config packages/db/vitest.config.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @ai-support-platform/db db:generate",
    "db:check": "pnpm --filter @ai-support-platform/db db:check",
    "db:migrate": "pnpm --filter @ai-support-platform/db db:migrate",
    "db:seed": "pnpm --filter @ai-support-platform/db db:seed",
    "db:studio": "pnpm --filter @ai-support-platform/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
